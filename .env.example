# Skopiuj ten plik jako .env i uzupełnij. Plik .env NIE trafia do repozytorium.

# Słowo aktywujące (kilka wariantów oddziel znakiem |)
WAKE_WORD=kaszel

# Indeks mikrofonu (python -m sounddevice pokazuje listę). Puste = domyślny.
MIC_DEVICE_INDEX=

# Nazwa modelu w Ollamie (tworzony z models/asystent.Modelfile)
OLLAMA_MODEL=asystent

# Próbka głosu do klonowania, plik w folderze voices/
VOICE_FILE=default.wav

# Spotify - https://developer.spotify.com/dashboard (opcjonalnie)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Foldery robocze (opcjonalnie)
PROJECTS_DIR=
NOTES_DIR=
SCREENSHOTS_DIR=
